# Optional: copy to .env to override docker-compose.yaml defaults (`make up` works without it).

# Signs JWTs; the back runs with APP_ENV=production, so it must be at least 32 bytes.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Load demo data (SPEC §6) on start.
SEED_DEMO_DATA=true
# MinIO root credentials, also used by the back as S3 keys.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# OTLP/gRPC endpoint for traces; empty = not exported. `make obs` sets jaeger:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=
