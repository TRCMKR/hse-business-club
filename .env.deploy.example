# Secrets of the hbc.trcmkr.ru stand. Copy to .env.deploy (gitignored) and fill in:
#   cp .env.deploy.example .env.deploy
# `make deploy*` exports these variables; .kamal/secrets maps them to the containers.
# Values must be URL-safe (the DB password goes into POSTGRES_DSN): use hex.
# Changing HBC_POSTGRES_PASSWORD or HBC_S3_* after the first `make deploy-setup` does
# not update existing data: reset the stand (README §Деплой) or change them in place.

# Signs JWTs; at least 32 bytes in production.   openssl rand -hex 32
HBC_JWT_SECRET=
# PostgreSQL password of the `hbc` user.          openssl rand -hex 24
HBC_POSTGRES_PASSWORD=
# MinIO root user = S3 access key of the back.     echo "hbc-$(openssl rand -hex 6)"
HBC_S3_ACCESS_KEY=
# MinIO root password = S3 secret key (>= 8 chars). openssl rand -hex 32
HBC_S3_SECRET_KEY=

# Docker Hub credentials (access token). Leave empty if DOCKERHUB_USERNAME and
# DOCKERHUB_PASSWORD are exported by your shell profile (~/.zprofile).
# DOCKERHUB_USERNAME=
# DOCKERHUB_PASSWORD=
