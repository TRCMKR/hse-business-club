# Copy to .env for `make run` (read only when APP_ENV=local).
# Infrastructure: `make test-env-up` (root compose test env hbc-test-env: postgres on 5433, MinIO on 9000).
APP_ENV=local
LOG_LEVEL=debug

HTTP_ADDR=:8080
DEBUG_ADDR=:8081
GRPC_ADDR=127.0.0.1:8082
CORS_ORIGINS=http://localhost:3000
SHUTDOWN_TIMEOUT=10s

POSTGRES_DSN=postgres://hbc:hbc@localhost:5433/hbc?sslmode=disable
POSTGRES_MAX_CONNS=10

# In production JWT_SECRET is required and must be at least 32 bytes.
JWT_SECRET=local-dev-secret-change-me-please-32b
JWT_TTL=24h

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=hbc-avatars
S3_USE_SSL=false
S3_REGION=us-east-1

SEED_DEMO_DATA=false

# Empty = do not export spans. Jaeger all-in-one: localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=hbc-back
OTEL_TRACES_SAMPLER_ARG=1.0
