# Kamal secrets for config/deploy.back.yml and config/deploy.front.yml.
# Only references to environment variables: this file is safe for git. The values live
# in .env.deploy (gitignored, template: .env.deploy.example) and, for Docker Hub, in the
# DOCKERHUB_* variables of your shell profile. `make deploy*` loads both.
# DO NOT put raw credentials here.

# Docker Hub (images trcmkr/hbc-back, trcmkr/hbc-front); use an access token.
KAMAL_REGISTRY_USERNAME=$DOCKERHUB_USERNAME
KAMAL_REGISTRY_PASSWORD=$DOCKERHUB_PASSWORD

# Back
JWT_SECRET=$HBC_JWT_SECRET
S3_ACCESS_KEY=$HBC_S3_ACCESS_KEY
S3_SECRET_KEY=$HBC_S3_SECRET_KEY
POSTGRES_DSN=postgres://hbc:${HBC_POSTGRES_PASSWORD}@hbc-db:5432/hbc?sslmode=disable

# Accessories: PostgreSQL and MinIO (the back uses the MinIO root keys as S3 keys)
POSTGRES_PASSWORD=$HBC_POSTGRES_PASSWORD
MINIO_ROOT_USER=$HBC_S3_ACCESS_KEY
MINIO_ROOT_PASSWORD=$HBC_S3_SECRET_KEY
